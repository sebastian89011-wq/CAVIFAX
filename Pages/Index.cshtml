@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

@* 1. Encabezado *@
<div class="text-center">
    <h1 class="display-4">Bienvenido a CAVIFAX</h1>
    <p class="text-muted">Hoy es @DateTime.Today.ToString("dddd dd 'de' MMMM 'de' yyyy")</p>
</div>

@* 2. Avisos: solo aparecen si hay algo que atender *@
@if (Model.NominaEnBorrador != null)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span>
            <strong>Nómina sin autorizar:</strong>
            la semana del @Model.SemanaBorrador está en borrador.
        </span>
        <a asp-page="/NominaSemanal/Detalle" asp-route-id="@Model.NominaEnBorrador.IdNomina" class="btn btn-sm btn-warning">Revisar</a>
    </div>
}
@if (Model.ObrasConSaldoBajo > 0)
{
    <div class="alert alert-danger">
        <strong>Saldo bajo:</strong> @Model.ObrasConSaldoBajo obra(s) ya pasaron su límite de alerta de presupuesto.
    </div>
}

@* 3. Tarjetas con números clave. stretched-link hace clic en toda la tarjeta *@
<div class="row text-center mt-4">

    <div class="col-md-3 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Empleados activos</div>
                <div class="fs-3 fw-bold">@Model.EmpleadosActivos</div>
                <a asp-page="/Empleados/Index" class="stretched-link"></a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Obras activas</div>
                <div class="fs-3 fw-bold">@Model.ObrasActivas</div>
                <a asp-page="/Obras/Index" class="stretched-link"></a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card h-100 @(Model.PagosPendientes > 0 ? "border-danger" : "")">
            <div class="card-body">
                <div class="text-muted">Pagos por entregar</div>
                <div class="fs-3 fw-bold @(Model.PagosPendientes > 0 ? "text-danger" : "")">@Model.PagosPendientes</div>
                <div class="text-muted small">@Model.PagosPendientesTotal.ToString("C")</div>
                <a asp-page="/NominaSemanal/Index" class="stretched-link"></a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Préstamos activos</div>
                <div class="fs-3 fw-bold">@Model.PrestamosActivos</div>
                <div class="text-muted small">Saldo: @Model.PrestamosTotal.ToString("C")</div>
                <a asp-page="/Prestamos/Index" class="stretched-link"></a>
            </div>
        </div>
    </div>

</div>

@* 4. Presupuesto de mano de obra de cada obra activa *@
<h4 class="mt-3">Presupuesto de obras activas</h4>
<div class="row">
    @foreach (var r in Model.Obras)
    {
        <div class="col-md-6 mb-3">
            <div class="card h-100 @(r.Alerta ? "border-danger" : "")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title mb-1">@r.Obra.Nombre</h5>
                        @if (r.Alerta)
                        {
                            <span class="badge bg-danger">Saldo bajo</span>
                        }
                    </div>
                    <div class="text-muted small mb-2">@Model.NombreCliente(r.Obra.IdCliente)</div>

                    <div class="progress mb-2" style="height: 20px">
                        <div class="progress-bar @(r.Alerta ? "bg-danger" : "")" style="width: @r.Porcentaje%">@r.Porcentaje%</div>
                    </div>

                    <div class="d-flex justify-content-between small">
                        <span>Gastado: <strong>@r.Gastado.ToString("C")</strong></span>
                        <span>Saldo: <strong class="@(r.Alerta ? "text-danger" : "text-success")">@r.Saldo.ToString("C")</strong></span>
                    </div>
                    <a asp-page="/Obras/Detalle" asp-route-id="@r.Obra.IdObra" class="stretched-link"></a>
                </div>
            </div>
        </div>
    }
</div>

@* 5. Accesos rápidos a lo que más se usa *@
<h4 class="mt-3">Accesos rápidos</h4>
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-page="/Asistencias/Index" class="btn btn-primary">Capturar asistencias</a>
    <a asp-page="/NominaSemanal/Index" class="btn btn-outline-primary">Generar nómina</a>
    <a asp-page="/Prestamos/Crear" class="btn btn-outline-primary">Nuevo préstamo</a>
    <a asp-page="/Empleados/Crear" class="btn btn-outline-primary">Nuevo empleado</a>
</div>
