@{
    // Página que se está viendo, por ejemplo "/Obras/Detalle". Sirve para marcar la sección activa del menú.
    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Activo(string seccion) =>
        seccion == "/Index" ? (paginaActual == "/Index" ? "active" : "")
                            : (paginaActual.StartsWith(seccion) ? "active" : "");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAVIFAX</title>
    <link rel="icon" type="image/png" href="~/img/favicon.png" />
    <script type="importmap"></script>

    @* Fuente Montserrat: letras geométricas, parecidas a las del logo *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />

    @* Orden: primero Bootstrap y después nuestro CSS, para que site.css le gane *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Nominas.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-white mb-4">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <img src="~/img/logo-cavi.png" alt="CAVI Edificaciones" class="logo-cavi" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link @Activo("/Index")" asp-page="/Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link @Activo("/Empleados/")" asp-page="/Empleados/Index">Empleados</a></li>
                        <li class="nav-item"><a class="nav-link @Activo("/Obras/")" asp-page="/Obras/Index">Obras</a></li>
                        <li class="nav-item"><a class="nav-link @Activo("/Asistencias/")" asp-page="/Asistencias/Index">Asistencias</a></li>
                        <li class="nav-item"><a class="nav-link @Activo("/NominaSemanal/")" asp-page="/NominaSemanal/Index">Nómina</a></li>
                        <li class="nav-item"><a class="nav-link @Activo("/Prestamos/")" asp-page="/Prestamos/Index">Préstamos</a></li>
                        <li class="nav-item"><a class="nav-link @Activo("/Clientes/")" asp-page="/Clientes/Index">Clientes</a></li>
                        <li class="nav-item"><a class="nav-link @Activo("/Puestos/")" asp-page="/Puestos/Index">Puestos</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @* Mensaje de confirmación que deja una página antes de redirigir (TempData["Mensaje"]) *@
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            &copy; 2026 CAVI Edificaciones &middot; Sistema de nómina CAVIFAX
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
