@page
@model Nominas.Web.Pages.Prestamos.CrearModel
@{
    ViewData["Title"] = "Nuevo préstamo";
}

<h1>Nuevo préstamo o anticipo</h1>

<form method="post" class="col-lg-8">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Prestamo.IdEmpleado" class="form-label">Empleado</label>
            <select asp-for="Prestamo.IdEmpleado" asp-items="Model.Empleados" class="form-select" required>
                <option value="">Selecciona...</option>
            </select>
            <div class="form-text">Solo aparecen empleados activos sin otro préstamo activo.</div>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Prestamo.Tipo" class="form-label">Tipo</label>
            <select asp-for="Prestamo.Tipo" asp-items="Html.GetEnumSelectList<TipoPrestamo>()" class="form-select"></select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Prestamo.Monto" class="form-label">Monto ($)</label>
            <input asp-for="Prestamo.Monto" type="number" step="0.01" min="0.01" class="form-control" required />
            <div class="form-text">Cantidad que se le entrega hoy al trabajador.</div>
            <div id="ayuda-anticipo" class="form-text">
                Se descuenta completo en la siguiente nómina. No puede pasar de una semana de sueldo del empleado.
            </div>
        </div>
        <div id="campo-abono" class="col-md-4 mb-3">
            <label asp-for="Prestamo.AbonoSemanal" class="form-label">Abono semanal ($)</label>
            <input asp-for="Prestamo.AbonoSemanal" type="number" step="0.01" min="0.01" class="form-control" required />
            <div class="form-text">Cuánto se le descuenta en cada nómina semanal.</div>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Prestamo.Fecha" class="form-label">Fecha de entrega</label>
            <input asp-for="Prestamo.Fecha" type="date" class="form-control" required />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <script>
        // En un anticipo solo se captura el monto: el abono es el monto completo
        // (PrestamoService lo vuelve a fijar al guardar)
        (() => {
            const tipo = document.getElementById('Prestamo_Tipo');
            const campoAbono = document.getElementById('campo-abono');
            const abono = document.getElementById('Prestamo_AbonoSemanal');
            const ayuda = document.getElementById('ayuda-anticipo');
            const anticipo = '@((int)TipoPrestamo.Anticipo)';

            const actualizar = () => {
                const esAnticipo = tipo.value === anticipo;
                campoAbono.hidden = esAnticipo;
                abono.disabled = esAnticipo;   // un campo deshabilitado no se envía ni se valida
                ayuda.hidden = !esAnticipo;
            };
            tipo.addEventListener('change', actualizar);
            actualizar();
        })();
    </script>
}
