@page
@model Nominas.Web.Pages.Empleados.IndexModel
@using Nominas.Entidades
@{
    ViewData["Title"] = "Empleados";
}

<h1>Empleados</h1>
<a asp-page="Crear" class="btn btn-primary mb-3">+ Nuevo empleado</a>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label asp-for="Buscar" class="form-label">Buscar</label>
        <input asp-for="Buscar" class="form-control" placeholder="Nombre, apellido, CURP o NSS" />
    </div>
    <div class="col-md-3">
        <label asp-for="Estatus" class="form-label">Estatus</label>
        <select asp-for="Estatus" asp-items="Html.GetEnumSelectList<EstatusEmpleado>()" class="form-select">
            <option value="">Todos</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (Model.HayFiltro)
        {
            <a asp-page="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Puesto</th>
            <th>Especialidad</th>
            <th>Contratación</th>
            <th>Estatus</th>
            <th class="text-end">Sueldo diario</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Empleados.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    @(Model.HayFiltro ? "Ningún empleado coincide con la búsqueda." : "Todavía no hay empleados registrados.")
                </td>
            </tr>
        }
        @foreach (var e in Model.Empleados)
        {
            <tr>
                <td><a asp-page="Detalle" asp-route-id="@e.IdEmpleado">@e.Nombre @e.ApellidoPaterno @e.ApellidoMaterno</a></td>
                <td>@Model.NombrePuesto(e.IdPuesto)</td>
                <td>@e.Especialidad</td>
                <td>@e.TipoContratacion</td>
                <td>
                    @if (e.Estatus == EstatusEmpleado.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else if (e.Estatus == EstatusEmpleado.BajaTemporal)
                    {
                        <span class="badge bg-warning text-dark">Baja temporal</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Baja definitiva</span>
                    }
                </td>
                <td class="text-end">@e.SueldoDiario.ToString("C")</td>
                <td><a asp-page="Editar" asp-route-id="@e.IdEmpleado" class="btn btn-sm btn-outline-primary">Editar</a></td>
            </tr>
        }
    </tbody>
</table>