@page
@model Nominas.Web.Pages.Obras.IndexModel
@using Nominas.Entidades
@{
    ViewData["Title"] = "Obras";
}

<h1>Obras</h1>
<a asp-page="Crear" class="btn btn-primary mb-3">+ Nueva obra</a>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label asp-for="Buscar" class="form-label">Buscar</label>
        <input asp-for="Buscar" class="form-control" placeholder="Obra, ubicación o cliente" />
    </div>
    <div class="col-md-3">
        <label asp-for="Estatus" class="form-label">Estatus</label>
        <select asp-for="Estatus" asp-items="Html.GetEnumSelectList<EstatusObra>()" class="form-select">
            <option value="">Todas</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (Model.HayFiltro)
        {
            <a asp-page="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Obra</th>
            <th>Cliente</th>
            <th>Estatus</th>
            <th class="text-end">Presupuesto</th>
            <th>Avance del gasto</th>
            <th class="text-end">Saldo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Obras.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    @(Model.HayFiltro ? "Ninguna obra coincide con la búsqueda." : "Todavía no hay obras registradas.")
                </td>
            </tr>
        }
        @foreach (var o in Model.Obras)
        {
            var gastado = Model.Gastado(o.IdObra);
            var saldo = o.PresupuestoManoObra - gastado;
            var porcentaje = o.PresupuestoManoObra > 0 ? (int)(gastado * 100 / o.PresupuestoManoObra) : 0;
            var alerta = saldo <= o.LimiteAlertaSaldo;
            var claseEstatus = o.Estatus switch
            {
                EstatusObra.Activa => "bg-success",
                EstatusObra.Suspendida => "bg-warning text-dark",
                _ => "bg-secondary"
            };

            @* El color del renglón depende del estatus (Pages/Shared/ColorEstado.cs) *@
            <tr class="@ColorEstado.Fila(o.Estatus)">
                <td><a asp-page="Detalle" asp-route-id="@o.IdObra">@o.Nombre</a></td>
                <td>@Model.NombreCliente(o.IdCliente)</td>
                <td><span class="badge @claseEstatus">@o.Estatus</span></td>
                <td class="text-end">@o.PresupuestoManoObra.ToString("C")</td>
                <td style="min-width: 160px">
                    <div class="progress">
                        <div class="progress-bar @(alerta ? "bg-danger" : "")" style="width: @porcentaje%">@porcentaje%</div>
                    </div>
                </td>
                <td class="text-end">
                    @saldo.ToString("C")
                    @if (alerta)
                    {
                        <br /><span class="badge bg-danger">Saldo bajo</span>
                    }
                </td>
                <td><a asp-page="Editar" asp-route-id="@o.IdObra" class="btn btn-sm btn-outline-primary">Editar</a></td>
            </tr>
        }
    </tbody>
</table>
